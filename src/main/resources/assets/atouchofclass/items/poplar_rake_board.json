      {
        "when": ["gui", "firstperson_lefthand", "firstperson_righthand", "thirdperson_lefthand", "thirdperson_righthand"],
        "model": {
          "type": "minecraft:model",
          "model": "atouchofclass:item/poplar_rake_board"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "atouchofclass:block/poplar_rake_board"
    }
  }
}
